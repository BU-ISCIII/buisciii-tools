set -eo pipefail
module load Java/21.0.2
set -u
cd "${EXOMISER_APP}"
exec java -Xms300g -Xmx300g -jar exomiser-cli-15.1.0.jar analyse \\
    --analysis "${scratch_dir}/${yaml}"
EOF
}

