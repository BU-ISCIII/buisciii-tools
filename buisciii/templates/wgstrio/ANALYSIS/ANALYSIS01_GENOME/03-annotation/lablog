# module load singularity
# micromamba activate R_4.4.3

set -euo pipefail

# Resources for the different annotation software. VEP cache folder must follow the structure homo_sapiens/116_GRCh38/.
# VEP software version should be the same as the cache folder.
# The FASTA file for VEP should be the same one used previously for sarek execution.
VEP_CACHE="/data/ucct/bi/references/refgenie/alias/Homo_sapiens_Ensembl_GRCh38/cache_vep/release_116"
VEP_IMAGE="/data/ucct/bi/pipelines/singularity-images/ensembl-vep:116.0--pl5321h2a3209d_0"
VEP_FASTA="/data/ucct/bi/references/refgenie/alias/Homo_sapiens_GATK_GRCh38/fasta/v20181116/Homo_sapiens_assembly38.fasta"
DBNSFP_DIR="/data/ucct/bi/references/refgenie/alias/Homo_sapiens_dbNSFP/GRCh38/v5.4"
EXOMISER_APP="/data/ucct/bi/pipelines/exomiser/exomiser-cli-15.1.0/app"

for resource in "$VEP_IMAGE" "$VEP_FASTA" "$VEP_FASTA.fai" \
    "$DBNSFP_DIR/dbNSFP5.4_ENSG_gene.txt" \
    "$DBNSFP_DIR/dbNSFP5.4a_plugin_GRCh38.txt" \
    "$EXOMISER_APP/exomiser-cli-15.1.0.jar" \
    "$EXOMISER_APP/application.properties"
do
    [[ -s "$resource" ]] || { echo "ERROR: $resource missing" >&2; exit 1; }
done

scratch_dir=$(echo "$PWD" | sed "s/\/data\/ucct\/bi\/scratch_tmp/\/scratch/g")

ln -s "$DBNSFP_DIR/dbNSFP5.4_ENSG_gene.txt" dbNSFP_ENSG_gene_GRCh38.txt
ln -s "$DBNSFP_DIR/dbNSFP5.4a_plugin_GRCh38.txt" dbNSFP_ENSG_plugin_hg38.txt
mkdir -p vep
mkdir -p logs
mkdir -p exomiser/{exomiser,exomiser_exome,exomiser_genes}
mkdir -p filter_inheritance/{filter_inheritance,filter_inheritance_genes,filter_inheritance_exome}

#------------------------------------------------------------------------------------------------------------------

# 1 . Lablog to modify VCF ID field before running VEP.
echo "awk 'BEGIN{FS=\"\t\";OFS=\"\t\"} {if( \$0 ~ /^#/ ){print \$0}else{printf \"%s\t%s\t%s\t\", \$1,\$2,\$1\"_\"\$2\"_\"\$4\"_\"\$5 ; for (i=4; i<=NF; i++){printf \"%s\t\",\$i} ; printf \"\n\"}}' ../02-postprocessing/variants_fil.vcf > ./vep/variants_fil_mod.vcf" > _01_bcftools_query.sh
echo "sed -i 's/\t$//' ./vep/variants_fil_mod.vcf" >> _01_bcftools_query.sh

# 2. Create variant table.

echo "singularity exec -B ${scratch_dir}/../../../ /data/ucct/bi/pipelines/singularity-images/bcftools:1.12--h45bccc9_1 bcftools query -H -f '%CHROM\t%POS\t%ID\t%REF\t%ALT\t%FILTER\t[%GT\t%DP\t%AD\t%GQ\t]\n' ${scratch_dir}/vep/variants_fil_mod.vcf > ${scratch_dir}/vep/variants.table" >> _01_bcftools_query.sh
echo "sed -i -r 's/(#|\[[0-9]+\])//g' ./vep/variants.table;sed -i 's/:/_/g' ./vep/variants.table;sed -i 's/ //g' ./vep/variants.table;sed -i 's/\t*$//g' ./vep/variants.table " >> _01_bcftools_query.sh
echo "srun --partition short_idx --time 2:00:00 --chdir ${scratch_dir} --output logs/BCFTOOLSQUERY.log --job-name BCFTOOLSQUERY bash ./_01_bcftools_query.sh &" > _01_run_bcftools_query.sh

#--------------------------------------------------------------------------------------------------------------------

# 3. Lablog for annotating whole genome samples using Variant Effect Predictor (VEP).

# Run Vep without the plugin columns

cat > _02_vep_annotation.sh <<EOF
#!/usr/bin/env bash
set -euo pipefail
srun --partition short_idx --cpus-per-task 16 --mem 100G --time 12:00:00 \\
    --chdir "${scratch_dir}" --output "logs/VEP.log" --job-name VEP \\
    singularity exec \\
    -B /data/ucct/bi/references \\
    -B "${scratch_dir}/../../../" \\
    "${VEP_IMAGE}" vep \\
    --fasta "${VEP_FASTA}" \\
    -i "${scratch_dir}/vep/variants_fil_mod.vcf" \\
    -o "${scratch_dir}/vep/vep_annot.vcf" \\
    --cache --offline --dir_cache "${VEP_CACHE}" --cache_version 116 \\
    --everything --assembly GRCh38 --species homo_sapiens \\
    --tab --fork 16 --force_overwrite &
EOF

#--------------------------------------------------------------------------------------------------------------------

# 4. Modify vep_annot.vcf in order to eliminate columns that start with ##, rename column #Uploaded_variation as ID

printf '%s\n' '#!/usr/bin/env bash' 'set -euo pipefail' > _03_Vep_plugin_dbNSFP_parse.sh
echo "grep -v '^##' ./vep/vep_annot.vcf > ./vep/vep_annot_head.txt" >> _03_Vep_plugin_dbNSFP_parse.sh
echo "sed -i 's/#Uploaded_variation/ID/' ./vep/vep_annot_head.txt" >> _03_Vep_plugin_dbNSFP_parse.sh

# 5. Merge everything with Merge_All.R (one job). Inside the script:
#    - subset_dbnsfp.awk keeps only the dbNSFP rows for the variants in variants.table.
#    - VEP is read in chunks and joined with dbNSFP variants, dbNSFP genes and variants.table, to avoid OOM errors.
#    Requirements in ${scratch_dir}:
#      Merge_All.R and subset_dbnsfp.awk (must be in the same folder),
#      dbNSFP_ENSG_plugin_hg38.txt, dbNSFP_ENSG_gene_GRCh38.txt,
#      vep/variants.table, vep/vep_annot_head.txt
#    Outputs: vep/vep_plugin.txt, vep/vep_dbNSFP.txt, vep/dbNSFP_case.txt,
#    variants_annot_all.tab (final table).

echo "srun --partition short_idx --cpus-per-task 4 --mem 200G --time 12:00:00 --chdir ${scratch_dir} --output logs/MERGE_ALL.log --job-name MERGE_ALL Rscript Merge_All.R &" >> _03_Vep_plugin_dbNSFP_parse.sh

# 6. Filter variants_annot_all.tab based on MAX_AF

echo "max_af_col=\$( head -n 1 variants_annot_all.tab | tr '\t' '\n' | nl -v0 | grep -i 'MAX_AF$' | awk '{print \$1 + 1}' )" > aux_04_awk.sh
echo "{" >> aux_04_awk.sh
echo "  head -n 1 variants_annot_all.tab" >> aux_04_awk.sh
echo "  awk -F'\t' -v max_af_col=\$max_af_col 'NR>1 && \$max_af_col > 0.001 {print \$0}' variants_annot_all.tab" >> aux_04_awk.sh
echo "} > variants_annot_filterAF_head.tab" >> aux_04_awk.sh
echo "srun --partition short_idx --time 2:00:00 --chdir ${scratch_dir} --output logs/AWK_FILTER.log --job-name AWK_FILTER bash ./aux_04_awk.sh &" >> _04_filter_annotations_table.sh

