singularity {
	enabled                = true
	autoMounts             = true
	docker.enabled         = false
	podman.enabled         = false
	shifter.enabled        = false
	charliecloud.enabled   = false
}

process {
	executor = 'slurm'
	queue = 'middle_idx'
	errorStrategy = { task.exitStatus in [140,143,137,138,104] ? 'retry' : 'finish'; task.exitStatus in [1,4,134,139,255] ? 'ignore' : 'finish' }
	maxRetries = 1
	maxErrors = '-1'

	withName: FILTERVARIANTTRANCHES {
		ext.prefix       = {"${meta.id}.haplotypecaller"}
		ext.args         = { "--info-key CNN_1D --lenient --disable-sequence-dictionary-validation" }
	}
}

params {
	max_memory = 376.GB
	max_cpus = 32
	max_time = '48.h'
	genomes {
	'GATK.GRCh38' {
		ascat_alleles           = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/annotation_ASCAT/v20220623/G1000_alleles_hg38.zip"
        ascat_genome            = 'hg38'
        ascat_loci              = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/annotation_ASCAT/v20220623/G1000_loci_hg38.zip"
        ascat_loci_gc           = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/annotation_ASCAT/v20220623/GC_G1000_hg38.zip"
        ascat_loci_rt           = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/annotation_ASCAT/v20220623/RT_G1000_hg38.zip"
        bwa                     = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/bwa_index/v20181116/"
        chr_dir                 = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/chromosomes/v20181116/"
        dbsnp                   = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/annotation_GATKBundle/v20181116/dbsnp_146.hg38.vcf.gz"
        dbsnp_tbi               = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/annotation_GATKBundle/v20181116/dbsnp_146.hg38.vcf.gz.tbi"
        dict                    = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/fasta/v20181116/Homo_sapiens_assembly38.dict"
        fasta                   = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/fasta/v20181116/Homo_sapiens_assembly38.fasta"
        fasta_fai               = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/fasta/v20181116/Homo_sapiens_assembly38.fasta.fai"
        germline_resource       = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/annotation_GATKBundle/v20181116/af-only-gnomad.hg38.vcf.gz"
        germline_resource_tbi   = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/annotation_GATKBundle/v20181116/af-only-gnomad.hg38.vcf.gz.tbi"
        intervals               = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/annotation_intervals/v20220903/wgs_calling_regions_noseconds.hg38.bed"
        known_indels            = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/annotation_GATKBundle/v20181116/{Mills_and_1000G_gold_standard.indels.hg38,Homo_sapiens_assembly38.known_indels}.vcf.gz"
        known_indels_tbi        = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/annotation_GATKBundle/v20181116/{Mills_and_1000G_gold_standard.indels.hg38,Homo_sapiens_assembly38.known_indels}.vcf.gz.tbi"
        known_snps              = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/annotation_GATKBundle/v20181116/1000G_omni2.5.hg38.vcf.gz"
        known_snps_tbi          = "${params.igenomes_base}/Homo_sapiens_GATK_GRCh38/annotation_GATKBundle/v20181116/1000G_omni2.5.hg38.vcf.gz.tbi"
		snpeff_db             = 'GRCh38.99'
		vep_cache_version     = '116'
        vep_genome            = 'GRCh38'
        vep_species           = 'homo_sapiens'
		pon                   = null
        pon_tbi               = null
        cf_chrom_len          = null
        bwamem2               = null
        dragmap               = null
        msisensor2_models     = null
        msisensorpro_scan     = null
		}
	}
}
