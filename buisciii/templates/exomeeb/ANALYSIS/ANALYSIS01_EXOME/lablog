# module load Nextflow singularity

ln -s ../00-reads/ .
ln -s ../samples_id.txt .

echo -e "patient,sex,status,sample,lane,fastq_1,fastq_2" > samplesheet.csv
cat samples_id.txt | xargs -I % echo -e "%,NA,0,%,1,00-reads/%_R1.fastq.gz,00-reads/%_R2.fastq.gz" >> samplesheet.csv

while read -r sample;
do
	family_id=${sample%?}
    echo -e "$family_id\t${sample}_${sample}\t0_0\t0_0\t1\t2" >> ../../DOC/family.ped
done < ./samples_id.txt

scratch_dir=$(echo $PWD | sed "s/\/data\/ucct\/bi\/scratch_tmp/\/scratch/g")

cat <<EOF > sarek.sbatch
#!/bin/sh
#SBATCH --ntasks 1
#SBATCH --cpus-per-task 2
#SBATCH --mem 4G
#SBATCH --time 2-00:00:0
#SBATCH --partition middle_idx
#SBATCH --output $(date '+%Y%m%d')_sarek01.log
#SBATCH --chdir $scratch_dir

export NXF_OPTS="-Xms500M -Xmx4G"

nextflow run /data/ucct/bi/pipelines/nf-core-sarek/nf-core-sarek_3.10.0/3_10_0/main.nf \\
        -c ../../DOC/hpc_slurm_sarek.config \\
        -params-file ../../DOC/exomeeb_sarek_params.yaml \\
        --input 'samplesheet.csv' \\
        --outdir 01-sarek \\
        --genome GATK.GRCh38 \\
        --intervals '/data/ucct/bi/references/refgenie/alias/exome_beds/Nextera_flex_for_enrichment_Illumina/v2.5_hg38/hg38_Twist_Bioscience_for_Illumina_Exome_2_5.bed' \\
        --igenomes_base '/data/ucct/bi/references/refgenie/alias' \\
        --tools 'haplotypecaller' \\
        -resume
EOF

echo "sbatch sarek.sbatch" > _01_run_sarek.sh

echo "srun --partition middle_idx --chdir $scratch_dir rm -rf work &" > _02_clean.sh
